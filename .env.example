# Copy to .env.local. Values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Net worth step (optional). Claude reviews the rules estimate with one of these; without them
# the rules estimate is saved as is.
ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=
# Salary search snippets (levels.fyi + Glassdoor) for jobs levels.fyi pages don't cover. Optional.
FIRECRAWL_API_KEY=
# Bearer secret for POST /api/net-worth's personIds / missing / force / dry / deep. Unset = only { personId }. Server only.
NETWORTH_API_SECRET=
