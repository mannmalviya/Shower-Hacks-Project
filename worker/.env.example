# Copy to worker/.env. Never commit the real file.

# Supabase (service role: the worker writes people / follows / scrape_jobs)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Zo Computer API key (Zo > Settings > Advanced > Access tokens). Starts with zo_sk_
ZO_API_KEY=

# Backend order per platform, first success wins. Options: zo, harness, http
SCRAPE_ORDER_LINKEDIN=zo,harness
SCRAPE_ORDER_INSTAGRAM=http,zo,harness
SCRAPE_ORDER_X=zo,harness

# Seconds to wait between browser-harness scrapes of the same site (ban protection)
HARNESS_MIN_DELAY=8

# Optional: path to the browser-harness CLI if it is not on PATH
# BROWSER_HARNESS_BIN=/Users/you/.local/bin/browser-harness
