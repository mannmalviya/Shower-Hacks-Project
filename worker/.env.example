# Copy to worker/.env. Never commit the real file.

# Supabase: the worker writes people / follows / scrape_jobs with the secret key (skips RLS).
# Same names as the app's .env.local; if this file is missing, the worker reads ../.env.local.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Optional (opt-in zo backend): Zo Computer API key (Zo > Settings > Advanced > Access tokens). Starts with zo_sk_
ZO_API_KEY=

# Backend order per platform, first success wins. Options: harness, zo, http
SCRAPE_ORDER_LINKEDIN=harness
SCRAPE_ORDER_INSTAGRAM=harness
SCRAPE_ORDER_X=harness

# Seconds to wait between browser-harness scrapes of the same site (ban protection)
HARNESS_MIN_DELAY=8

# Instagram followers: how many to read from the list, and how many get a full profile visit
FOLLOWERS_LIMIT=100
FOLLOWERS_VISIT=10

# Optional: path to the browser-harness CLI if it is not on PATH
# BROWSER_HARNESS_BIN=/Users/you/.local/bin/browser-harness
